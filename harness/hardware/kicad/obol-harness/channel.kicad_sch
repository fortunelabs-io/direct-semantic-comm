			(font
				(face "Noto Sans CJK HK")
				(size 1.905 1.905)
				(thickness 0.254)
				(bold yes)
				(color 0 0 72 1)
			)
			(justify left)
		)
		(uuid "54ab4623-730f-495f-8c21-f54ff72594ff")
	)
